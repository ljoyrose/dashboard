{
  "name": "dashboard-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Automated browser tests for the dashboard. The dashboard itself has no build step.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:live": "LIVE_SMOKE=1 playwright test --project=live-smoke",
    "report": "playwright show-report",
    "test:phone": "playwright test --project=phone",
    "check:headers": "node tests/contract/check-real-headers.js",
    "teeth": "node tests/teeth/run-teeth.js",
    "test:gate": "node --test tests/gate/gate.test.mjs",
    "gate": "node tools/gate/gate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
