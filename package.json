{
  "name": "dashboard-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Automated browser tests for the dashboard. The dashboard itself has no build step.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:live": "LIVE_SMOKE=1 playwright test --project=live-smoke",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
